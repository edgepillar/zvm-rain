# Rain's whole deployment. Copy it to .env, which docker-compose.yml beside it
# hands to the bot through env_file; the page's build reads the VITE_ names and
# RAIN_TOKENS and RAIN_BOT_USERNAME. .env is kept out of git and out of the image.

# --- Telegram
# From @BotFather: /newbot. Then /setprivacy -> Disable, or the bot sees only
# commands in groups that have not made it an admin, and /rain finds nobody
# talking. Only one process may poll a token, so give Rain a bot of its own.
RAIN_TELEGRAM_TOKEN=
# Comma-separated group ids to rain in. Empty: any group the bot is added to.
# Either way a rain only ever pays people who spoke in the group it was called in.
RAIN_CHATS=

# The bot's username without the @, for the page's links to it. Rebuild the
# web service after changing it.
RAIN_BOT_USERNAME=zvm_rain_bot
# Where the page is, for the links in the bot's /link and /fund replies.
RAIN_PAGE=http://localhost:47080/rain/

# --- Chain
# No node is built in. These are a local zvm-devnet's, at its default address
# (https://github.com/Zenoglyphs-VM/zvm-devnet). ZVM_RPC is the JSON-RPC the bot and the
# deploy commands use (RAIN_RPC overrides it for the bot alone), ZVM_NODE the
# node's API, for verification, and VITE_ZVM_NODE the node the page reads.
ZVM_RPC=http://localhost:47080/zvm/rpc
ZVM_NODE=http://localhost:47080/zvm
VITE_ZVM_NODE=http://localhost:47080/zvm
# Where the explorer is, for the links in the bot's messages (RAIN_PUBLIC
# overrides it) and on the page.
ZVM_GATEWAY=http://localhost:47080
VITE_GATEWAY=http://localhost:47080
# Tokens known by name, besides ZNN: NAME=0xaddress, comma-separated. Names
# match case-insensitively and are shown as written. Any other ERC-20 still
# works by its 0x address. wQSR is a predeploy, at this address on every ZVM;
# add the tokens this chain's own deploys made.
RAIN_TOKENS=wQSR=0x4200000000000000000000000000000000000101

# ZNS's ENSRegistry on this chain (zvm-zns's deployment record), for names in
# the bot's messages. Empty: addresses only.
ZNS_REGISTRY=

# --- Files, as the container sees them (docker-compose.yml mounts and bakes these)
RAIN_KEYS=/run/secrets/rain.json
RAIN_RECORD=/etc/zvm-rain/zvm.json
RAIN_DB=/data/rain.db

# --- Rain
# The window when /rain names none, and the largest it accepts, in minutes.
RAIN_DEFAULT_MINUTES=1
RAIN_MAX_MINUTES=60
# The most people one rain pays, the most recent speakers first. At most 100.
RAIN_MAX_RECIPIENTS=50
# How long a /link secret stays good.
RAIN_SECRET_TTL=1h

# --- Live tests only (go test ./internal/rain -run Live). Not read from this
# file on purpose: set, it spends devnet ZNN, so export it in the shell for
# the run that means it.
# RAIN_LIVE_RPC=
